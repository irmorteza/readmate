{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readmate.local/ocr-result.schema.json",
  "title": "OcrResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "engine", "lines", "boxes", "words"],
  "properties": {
    "version": { "const": 1 },
    "engine": { "type": "string" },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "box", "boxIds"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "text": {
            "type": "string",
            "description": "Unfiltered engine text of the line: may include characters whose boxes were dropped as noise, and a hyphen-broken line is not rejoined. Use words[] for cleaned text."
          },
          "box": { "$ref": "#/$defs/box" },
          "boxIds": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "raw", "lineId", "conf", "box", "wordId"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "raw": { "type": "string" },
          "lineId": { "type": "integer", "minimum": 0 },
          "conf": { "type": "number", "minimum": 0, "maximum": 1 },
          "box": { "$ref": "#/$defs/box" },
          "wordId": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "boxIds", "lineIds"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" },
          "boxIds": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "lineIds": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "sentences": {
      "type": "array",
      "description": "Words grouped in reading order; every word is in exactly one entry. Absent when produced by an older backend.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "wordIds", "text"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["sentence", "fragment", "incomplete"] },
          "wordIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "text": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
